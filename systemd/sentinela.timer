[Unit]
Description=Roda o Sentinela a cada 5 minutos
Documentation=https://github.com/alexsilvan84/sentinela

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min

# Espalha a execucao em ate 30s para varias maquinas nao baterem no mesmo
# endpoint HTTP no mesmo instante.
RandomizedDelaySec=30
Persistent=true

[Install]
WantedBy=timers.target
